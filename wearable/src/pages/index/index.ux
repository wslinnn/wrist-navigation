<template>
  <div class="page">
    <div class="home" if="{{ !settingsOpen }}" onclick="dismissExit">
      <text class="demo-label" if="{{ demo }}" style="font-size: {{ auxiliarySize }}px;">演示 · 非真实导航</text>
      <div class="navigation-stage" if="{{ guidance }}" style="top: {{ contentTop }}px; height: {{ contentHeight }}px;">
        <image class="arrow" src="{{ arrowSrc }}" style="left: {{ arrowLeft }}px; width: {{ arrowSize }}px; height: {{ arrowSize }}px;"></image>
        <list class="guidance-list" style="top: {{ guidanceTop }}px; height: {{ guidanceHeight }}px;">
          <list-item for="{{ guidanceLines }}" type="guidance" class="guidance-row" style="height: {{ rowHeight }}px;">
            <text class="guidance-text" style="height: {{ rowHeight }}px; line-height: {{ rowHeight }}px; font-size: {{ fontSize }}px;">{{ $item }}</text>
          </list-item>
        </list>
      </div>
      <div class="top-bar" if="{{ clockVisible }}" style="top: 12px; height: {{ titleHeight }}px;">
        <text class="clock" style="font-size: {{ fontSize }}px; line-height: {{ titleHeight }}px;">{{ clockText }}</text>
        <text class="speed" if="{{ speedText }}" style="font-size: {{ fontSize }}px; line-height: {{ titleHeight }}px; color: {{ speedLocating ? '#9aafa0' : '#80f5be' }};">{{ speedText }}</text>
      </div>
      <div class="rest" if="{{ !guidance }}" style="top: {{ restTop }}px; height: {{ restHeight }}px;">
        <div class="rest-titles" style="height: {{ restTitleHeight }}px;">
          <text for="{{ titleLines }}" class="rest-title" style="height: {{ titleHeight }}px; line-height: {{ titleHeight }}px; font-size: {{ fontSize }}px;">{{ $item }}</text>
        </div>
        <div class="rest-hints" style="top: {{ hintTop }}px; height: {{ hintsHeight }}px;">
          <text for="{{ hintLines }}" class="rest-hint" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px;">{{ $item }}</text>
        </div>
        <list class="details" if="{{ hasDetails }}" style="top: {{ detailsTop }}px; height: {{ detailsHeight }}px;">
          <list-item for="{{ rawLines }}" type="detail" class="detail-row" style="height: {{ hintHeight }}px;">
            <text class="raw" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px;">{{ $item }}</text>
          </list-item>
        </list>
        <text class="exit-hint" if="{{ exitHint }}" style="top: {{ restTop + restHeight + 10 }}px; font-size: {{ auxiliarySize }}px; line-height: {{ auxiliaryHeight }}px; height: {{ auxiliaryHeight }}px;">{{ exitHint }}</text>
      </div>
      <div class="settings-entry" onclick="openSettings">
        <image class="settings-icon" src="/common/settings.png"></image>
      </div>
    </div>
    <div class="settings" if="{{ settingsOpen }}">
      <text class="back" onclick="closeSettings">‹</text>
      <text class="settings-title" style="font-size: {{ fontSize }}px; height: {{ titleHeight }}px; line-height: {{ titleHeight }}px;">显示设置</text>
      <list class="settings-list" style="top: {{ settingsListTop }}px; height: {{ settingsListHeight }}px;">
        <list-item type="font-size" class="setting-block font-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px;">文字大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('fontSize', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px;">{{ fontSize }}</text>
            <text class="adjust increase" onclick="adjust('fontSize', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-size" class="setting-block arrow-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px;">箭头大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowSize', -2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px;">{{ arrowSize }}</text>
            <text class="adjust increase" onclick="adjust('arrowSize', 2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-weight" class="setting-block arrow-weight-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px;">箭头粗细</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowWeight', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px;">{{ arrowWeight }}</text>
            <text class="adjust increase" onclick="adjust('arrowWeight', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="footer" class="settings-footer" style="height: {{ footerHeight }}px;">
          <text class="save-status" style="font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px;">{{ saveStatus }}</text>
          <text class="version" style="top: {{ auxiliaryHeight + 4 }}px; font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px;">腕上导航 v{{ versionName }}</text>
        </list-item>
        <list-item type="reset" class="reset-row" style="height: {{ buttonHeight + 16 }}px;">
          <text class="reset-defaults" onclick="resetSettings" style="font-size: {{ labelSize }}px; height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px;">恢复默认</text>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
const protocol = require('../../common/protocol')
const presentation = require('../../common/presentation')
const haptics = require('../../common/haptics').create()
const metrics = require('../../common/metrics')
const settings = require('../../common/settings')
const manifest = require('../../manifest.json')
let preferenceStore = null
let connection = null
let latest = null
let receivedAt = 0
let connected = false
let timer = null
let connectionError = ''
// Device firmware decides the accepted send payload form; keep it across page re-creation.
let sendAsObject = false
let screenLit = false
let exitTimer = null
let exitDismissed = false
let clockTimer = null
// Speed follows the proven WristSpeed flow: a one-shot getLocation first
// (permission prompt + subsystem init), then the continuous subscription.
// GPS samples stale for 5s mean standstill, not a frozen reading.
let geolocation
let speedSubscribed = false
let speedFix = false
let currentKmh = 0
let lastSpeedSampleAt = 0
let staleTimer = null
let vibrator
// The vibrator feature is absent on some band firmware; a failed probe stays disabled.
function buzz(mode) {
  if (vibrator === false) return
  try {
    if (!vibrator) vibrator = require('@system.vibrator')
    vibrator.vibrate({ mode })
  } catch (error) { vibrator = false }
}
let alive = false
let visible = false
let screenRequested = false
let screenRevision = 0
let screenError = ''

export default {
  private: {
    settingsOpen: false,
    exitHint: '',
    clockText: '',
    clockVisible: false,
    speedText: '',
    speedLocating: false,
    fontSize: settings.DEFAULTS.fontSize,
    arrowSize: settings.DEFAULTS.arrowSize,
    arrowWeight: settings.DEFAULTS.arrowWeight,
    labelSize: 24, hintSize: 22, auxiliarySize: 18,
    titleHeight: 42, labelHeight: 28, hintHeight: 31, auxiliaryHeight: 23,
    buttonHeight: 52, controlTop: 32, settingRowHeight: 96,
    footerHeight: 50,
    adjustSize: 35,
    settingsListTop: 66, settingsListHeight: 398,
    titleLines: [], restTitleHeight: 42, hintTop: 54, hintsHeight: 62,
    saveStatus: '调整后自动保存',
    versionName: manifest.versionName,
    guidanceLines: [' '],
    guidanceHeight: 48,
    rowHeight: 48,
    contentTop: 167,
    contentHeight: 146,
    arrowLeft: 105,
    guidanceTop: 98,
    hintLines: [],
    hasDetails: false,
    detailsTop: 0,
    detailsHeight: 0,
    restTop: 184,
    restHeight: 112,
    demo: false,
    arrowSrc: '/common/arrows/6/unknown.png',
    status: '等待导航',
    icon: '/common/unknown.png',
    distance: '',
    instruction: '',
    rawLines: [' '],
    header: '腕上导航',
    guidance: false,
    statusColor: '#64776b',
    distanceValue: '',
    distanceUnit: '',
    distanceSize: 72,
    hint: '在手机上连接小米运动健康'
  },
  onInit() {
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    this.settingsOpen = false
    this.applySettings(settings.DEFAULTS)
    latest = null
    receivedAt = 0
    connected = false
    connectionError = ''
    visible = false
    screenRequested = false
    screenError = ''
    alive = true
    this.paint()
  },
  // Establish interconnect only after the first screen has been created.
  onReady() {
    this.loadSettings()
    this.retry()
  },
  loadSettings() {
    if (!alive || preferenceStore) return
    try {
      preferenceStore = settings.createStore(require('@system.storage'),
        value => { if (alive) { this.applySettings(value); this.paint() } },
        value => { if (alive) this.saveStatus = value })
      preferenceStore.load()
    } catch (error) { this.saveStatus = '本次调整无法保存' }
  },
  applySettings(value) {
    const checked = settings.normalize(value)
    const type = presentation.typography(checked.fontSize)
    for (const field of Object.keys(type)) this[field] = type[field]
    this.settingsListTop = Math.max(66, 16 + type.titleHeight + 8)
    this.settingsListHeight = 464 - this.settingsListTop
    this.fontSize = checked.fontSize
    this.arrowSize = checked.arrowSize
    this.arrowWeight = checked.arrowWeight
  },
  adjust(field, change) {
    if (!alive || !settings.LIMITS[field]) return
    const value = this.currentSettings()
    value[field] += Number(change)
    const checked = settings.normalize(value)
    if (this[field] === checked[field]) return
    this.saveSettings(checked)
  },
  currentSettings() {
    return { fontSize: this.fontSize, arrowSize: this.arrowSize, arrowWeight: this.arrowWeight }
  },
  saveSettings(value) {
    if (!alive) return
    const checked = settings.normalize(value)
    this.applySettings(checked)
    this.paint()
    if (preferenceStore) preferenceStore.save(checked)
    else this.saveStatus = '本次调整无法保存'
  },
  resetSettings() { this.saveSettings(settings.DEFAULTS) },
  openSettings() { exitDismissed = true; this.cancelExit(); this.settingsOpen = true; this.paint() },
  closeSettings() { this.settingsOpen = false; this.paint() },
  onBackPress() {
    if (this.settingsOpen) { this.closeSettings(); return true }
    return false
  },
  // After navigation ends the app returns to the watchface on a visible
  // countdown; any touch keeps it open (platform convention for task apps).
  scheduleExit() {
    if (exitTimer) return
    let left = 5
    const tick = () => {
      if (!alive) { exitTimer = null; return }
      if (this.settingsOpen) { exitDismissed = true; this.cancelExit(); return }
      if (left <= 0) {
        exitTimer = null
        this.exitHint = ''
        try { require('@system.router').back() } catch (error) { /* Staying open beats a failed exit. */ }
        return
      }
      this.exitHint = '轻触屏幕停留 · ' + left + ' 秒后返回表盘'
      left--
      exitTimer = setTimeout(tick, 1000)
    }
    tick()
  },
  cancelExit() {
    if (exitTimer) { clearTimeout(exitTimer); exitTimer = null }
    this.exitHint = ''
  },
  dismissExit() {
    exitDismissed = true
    this.cancelExit()
    this.paint()
  },
  // The data strip clock only runs while live navigation is on screen; it fires
  // just past each minute boundary so the shown minute never lags.
  scheduleClock() {
    if (clockTimer) return
    const tickClock = () => {
      clockTimer = null
      if (!alive || !visible) return
      this.paint()
      // An empty strip means navigation is no longer live; stop ticking.
      if (!this.dataText) return
      clockTimer = setTimeout(tickClock, 60000 - (Date.now() % 60000) + 50)
    }
    tickClock()
  },
  cancelClock() {
    if (clockTimer) { clearTimeout(clockTimer); clockTimer = null }
  },
  // Speed is only worth its battery while live navigation is on screen; every
  // lifecycle path that ends it must go through here.
  startSpeed() {
    if (speedSubscribed || !alive) return
    try {
      if (geolocation === false) return
      if (!geolocation) geolocation = require('@system.geolocation')
      // Some firmware calls fail synchronously; the flag keeps that path from
      // marking a refused subscription as active. Subscribe first: a synchronous
      // first fix would otherwise paint before the flag is set.
      let refused = false
      geolocation.subscribe({
        callback: data => { if (alive) this.applySpeed(data) },
        fail: () => {
          refused = true
          if (alive) { this.stopSpeed(); this.paint() }
        }
      })
      if (refused) return
      speedSubscribed = true
      geolocation.getLocation({
        timeout: 60000,
        success: data => { if (alive) this.applySpeed(data) },
        fail: () => { /* Speed is auxiliary; a refusal just keeps it hidden. */ }
      })
      // The packet paint ran before this subscription existed; show 定位中 now.
      this.paint()
    } catch (error) { geolocation = false }
  },
  stopSpeed() {
    if (staleTimer) { clearTimeout(staleTimer); staleTimer = null }
    currentKmh = 0
    speedFix = false
    if (!speedSubscribed) return
    speedSubscribed = false
    try {
      if (geolocation && geolocation !== false) geolocation.unsubscribe()
    } catch (error) { /* The page is going away either way. */ }
  },
  applySpeed(data) {
    const kmh = metrics.speedKmh(data && data.speed)
    if (kmh === null) return
    lastSpeedSampleAt = Date.now()
    speedFix = true
    currentKmh = kmh
    if (staleTimer) clearTimeout(staleTimer)
    // A subscription can go silent without failing; 5 stale seconds is standstill.
    staleTimer = setTimeout(() => {
      staleTimer = null
      if (!alive || !visible) return
      currentKmh = 0
      this.paint()
    }, 5000)
    // Hidden pages record the sample but must not repaint.
    if (visible) this.paint()
  },
  onShow() {
    visible = true
    this.paint()
    if (latest && latest.status === 'active') {
      this.scheduleClock()
      this.startSpeed()
    }
    if (connection) this.retry()
  },
  onHide() {
    visible = false
    this.cancelClock()
    this.stopSpeed()
    if (timer) clearTimeout(timer)
    timer = null
    this.keepScreenOn(false)
  },
  onDestroy() {
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    alive = false
    visible = false
    // Release again if the previous off request failed or is still pending.
    this.keepScreenOn(false, true)
    if (screenLit) {
      screenLit = false
      try {
        const brightness = require('@system.brightness')
        // Firmware-level reset for a keep-screen-on release that never landed.
        if (typeof brightness.systembrightnessrecovery === 'function') brightness.systembrightnessrecovery()
      } catch (error) { /* Older firmware has no recovery entry. */ }
    }
    if (timer) clearTimeout(timer)
    timer = null
    if (exitTimer) { clearTimeout(exitTimer); exitTimer = null }
    this.exitHint = ''
    this.cancelClock()
    this.stopSpeed()
    if (connection) {
      try {
        connection.onmessage = () => {}
        connection.onopen = () => {}
        connection.onclose = () => {}
        connection.onerror = () => {}
      } catch (error) { /* Some firmware rejects callback changes after disconnect. */ }
    }
    connection = null
    latest = null
    // Official memory guidance: one explicit GC after all references are dropped.
    try { if (typeof global !== 'undefined' && typeof global.runGC === 'function') global.runGC() } catch (error) { /* Firmware without runGC. */ }
  },
  ready() {
    this.send({ v: 1, type: 'ready' })
  },
  send(message) {
    this.transmit(message, sendAsObject, true)
  },
  // Vela 5 firmware (Band 10 Pro) types send data as an object and rejects the
  // JSON string with 202 "invalid args"; older firmware only accepts strings.
  transmit(message, asObject, canSwitch) {
    if (!connection || !alive) return
    const fail = (data, code) => {
      if (canSwitch && presentation.invalidArgs(data, code)) {
        sendAsObject = !asObject
        this.transmit(message, !asObject, false)
        return
      }
      this.failed('发送失败', data, code)
    }
    try {
      connection.send({
        data: asObject ? message : JSON.stringify(message),
        fail
      })
    } catch (error) { this.failed('发送失败', error) }
  },
  failed(stage, data, code) {
    if (!alive) return
    connected = false
    connectionError = presentation.errorText(stage, data, code)
    this.paint()
  },
  retry() {
    if (!alive) return
    connectionError = ''
    try {
      if (!connection) {
        // Lazy loading keeps missing/failed firmware APIs from aborting page creation.
        const interconnect = require('@system.interconnect')
        connection = interconnect.instance()
        connection.onopen = () => {
          if (!alive) return
          connected = true
          connectionError = ''
          this.ready()
          this.paint()
        }
        connection.onclose = data => this.failed('连接断开', data)
        connection.onerror = data => this.failed('连接异常', data)
        connection.onmessage = event => {
          if (!alive) return
          const packet = protocol.decode(event && event.data)
          if (!protocol.accept(latest, packet)) return
          latest = packet
          receivedAt = Date.now()
          connected = true
          connectionError = ''
          if (visible) this.paint()
          this.send({ v: 1, type: 'ack', session: packet.session, seq: packet.seq })
          const mode = haptics.update(packet)
          if (mode) buzz(mode)
          if (packet.status === 'ended') {
            this.cancelClock()
            this.stopSpeed()
            if (!exitDismissed) this.scheduleExit()
          } else {
            exitDismissed = false
            this.cancelExit()
            // Hidden pages restart nothing here; onShow re-arms both from the cached packet.
            if (packet.status === 'active' && visible) {
              this.scheduleClock()
              this.startSpeed()
            }
          }
        }
      }
      connection.getReadyState({
        success: data => {
          if (!alive) return
          connected = !!data && data.status === 1
          connectionError = ''
          if (connected) this.ready()
          this.paint()
        },
        fail: (data, code) => this.failed('连接检查失败', data, code)
      })
    } catch (error) {
      connection = null
      this.failed('互联初始化失败', error)
    }
    this.paint()
  },
  scheduleExpiry() {
    if (timer) clearTimeout(timer)
    timer = null
    if (!alive || !visible || !connected || !latest) return
    if (latest.status !== 'active' && latest.status !== 'demo') return
    const remaining = protocol.EXPIRY_MS - (Date.now() - receivedAt)
    if (remaining > 0) timer = setTimeout(() => { timer = null; this.paint() }, remaining)
  },
  keepScreenOn(value, force) {
    if (!force && screenRequested === value) return
    screenRequested = value
    if (value) screenLit = true
    screenError = ''
    const revision = ++screenRevision
    const fail = (data, code) => {
      if (!alive || revision !== screenRevision) return
      screenError = presentation.errorText(value ? '常亮开启失败' : '常亮关闭失败', data, code)
      this.paint()
    }
    try {
      // Load lazily: a missing brightness API must not stop navigation rendering.
      const brightness = require('@system.brightness')
      brightness.setKeepScreenOn({ keepScreenOn: value, fail })
    } catch (error) { fail(error) }
  },
  paint() {
    const now = Date.now()
    const age = now - receivedAt
    let view = protocol.present(latest, age, connected)
    this.keepScreenOn(visible && !this.settingsOpen && !!view.live && latest.keepScreenOn !== false)
    if (connectionError) {
      view.status = '连接不可用'
      view.rawText = connectionError
    }
    this.scheduleExpiry()
    if (this.status !== view.status) this.status = view.status
    const icon = '/common/' + view.icon + '.png'
    if (this.icon !== icon) this.icon = icon
    if (this.distance !== view.distance) this.distance = view.distance
    if (this.instruction !== view.instruction) this.instruction = view.instruction
    const layout = presentation.layout(view)
    this.demo = view.status === '演示 · 非真实导航'
    this.arrowSrc = '/common/arrows/' + this.arrowWeight + '/' + view.icon + '.png'
    const navigation = presentation.navigationLayout(view, this, screenError)
    for (const field of ['rowHeight', 'guidanceHeight', 'contentTop', 'contentHeight', 'arrowLeft', 'guidanceTop']) {
      if (this[field] !== navigation[field]) this[field] = navigation[field]
    }
    if (navigation.guidanceLines.join('\n') !== this.guidanceLines.join('\n')) this.guidanceLines = navigation.guidanceLines
    for (const field of ['header', 'guidance', 'statusColor', 'distanceValue', 'distanceUnit', 'distanceSize', 'hint']) {
      if (this[field] !== layout[field]) this[field] = layout[field]
    }
    const rest = presentation.restLayout(view, screenError, this)
    if (rest.titleLines.join('\n') !== this.titleLines.join('\n')) this.titleLines = rest.titleLines
    for (const field of ['restTitleHeight', 'hintTop', 'hintsHeight', 'hasDetails', 'detailsTop', 'detailsHeight', 'restTop', 'restHeight']) {
      if (this[field] !== rest[field]) this[field] = rest[field]
    }
    if (rest.hintLines.join('\n') !== this.hintLines.join('\n')) this.hintLines = rest.hintLines
    // Unchanged heartbeats renew expiry without rebuilding native views.
    if (rest.rawLines.join('\n') !== this.rawLines.join('\n')) this.rawLines = rest.rawLines
    this.paintTopBar(view)
  },
  // The top band lives where the centered guidance stage can never reach (it
  // tops out at 292px of the 480px screen), so neither field is ever squeezed.
  paintTopBar(view) {
    const now = Date.now()
    const text = view.live ? metrics.clockText(now) : ''
    if (text !== this.clockText) this.clockText = text
    const visible = !!text
    if (this.clockVisible !== visible) {
      this.clockVisible = visible
      if (!visible) this.cancelClock()
    }
    // Once guidance stops being live the subscription is costing battery for nothing.
    if (!view.live && speedSubscribed) this.stopSpeed()
    let speed = ''
    if (view.live && speedSubscribed) {
      // While locating, say so — a blank corner reads as a broken feature.
      speed = speedFix ? (now - lastSpeedSampleAt <= 5000 ? currentKmh : 0) + 'km/h' : '定位中'
    }
    if (speed !== this.speedText) this.speedText = speed
    const locating = speed === '定位中'
    if (this.speedLocating !== locating) this.speedLocating = locating
  }
}
</script>

<style>
.page { position: relative; width: 336px; height: 480px; background-color: #000000; }
.home { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px; }
.navigation-stage { position: absolute; left: 24px; width: 288px; height: 110px; }
.arrow { position: absolute; top: 0px; width: 42px; height: 42px; object-fit: contain; }
.guidance-list { position: absolute; left: 0px; width: 288px; height: 42px; }
.guidance-row { width: 288px; height: 42px; flex-shrink: 0; }
.guidance-text { width: 288px; height: 42px; color: #ffffff; font-size: 30px; line-height: 42px; text-align: center; }
.settings-entry { position: absolute; left: 136px; top: 400px; width: 64px; height: 64px; border-radius: 32px; background-color: #101a14; }
.settings-icon { position: absolute; left: 11px; top: 11px; width: 42px; height: 42px; object-fit: contain; }
.demo-label { position: absolute; top: 26px; left: 24px; width: 288px; height: 38px; color: #d4b57b; text-align: center; }
